# 必須: controller / simulation / probe / physics_check。
ROLE=controller
# 必須: Genesisの物理計算装置。metal / cpu。
GENESIS_BACKEND=metal
# 必須: SmolVLAの推論装置。mps / cpu。
DEVICE=mps
# 必須: Genesisの対話画面。録画用のカメラはfalseでも有効。
SHOW_VIEWER=false
# 必須: ローカルのROS 2ブリッジ。
ROSBRIDGE_URL=ws://127.0.0.1:9091
# 必須: ROS応答・初回コンパイルの待ち時間、秒。
ROS_TIMEOUT_SECONDS=600
# 必須: 指令・観測トピックの接頭辞。
TOPIC_PREFIX=/ramen_soft
# 必須: 公開SmolVLAのモデルと固定リビジョン。
MODEL_ID=HuggingFaceVLA/smolvla_libero
MODEL_REVISION=6721902bc4d61e50a3bfdb11dfb4cb626f05d102
# 必須: 公開モデルの取得先。
HF_HOME=../.cache/huggingface
# 必須: Genesisのコンパイル・形状キャッシュ先。
GENESIS_CACHE_DIR=.cache/genesis
# 必須: 実行ごとの記録先。
OUTPUT_DIR=output
# 必須: 対象と把持指示を並べたJSON。
TASK_FILE=input/tasks.json
# 必須: H.264出力に対応するffmpegの絶対パス。
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# 必須: ログレベル。
LOG_LEVEL=INFO
# 必須: 配置・モデルの乱数シード。
SEED=42
# 必須: 再観測までのモデル出力の実行数。
ACTION_STEPS=10
# 必須: 動作生成の拡散ステップ数。
DENOISING_STEPS=10
# 必須: 接触閉鎖の最大制御ステップ数。
GRASP_MAX_STEPS=120
# 必須: ルール制御の移動時間、秒。
RULE_MOVE_SECONDS=3.0
# 必須: 指先と具材の最下面との間隔、メートル。
APPROACH_CLEARANCE=0.0026
# 必須: 一回の実験の制御ステップ上限。
MAX_SIMULATION_STEPS=4000

# 必須: 弾性体のヤング率、Pa。実食品の測定値ではない。
YOUNG_MODULUS_PA=12000
# 必須: 弾性体のポアソン比。
POISSON_RATIO=0.3
# 必須: 弾性の減衰時間係数、秒。
ELASTIC_DAMPING=0.002
# 必須: 具材一個の質量、kg。
SOFT_MASS_KG=0.035
# 必須: SmolVLAの閉鎖提案を待つ制御ステップ数。
MODEL_PROPOSAL_STEPS=10
# 必須: 接触補助制御の一周期あたりの閉鎖量、m。
CLOSE_STEP=0.0005
# 必須: 指の駆動力による閉鎖停止の目安、N。具材との接触力ではない。
GRIP_LOAD_LIMIT=2.0
# 必須: 観測した半幅に対する目標開き幅の最大圧縮率。
MAX_COMPRESSION=0.25
# 必須: 具材ごとの把持試行の上限。
MAX_ATTEMPTS=3
# 必須: 開放後の静止確認の最大ステップ数。
SETTLE_STEPS=60
# 必須: 剛体移動を除いた形状変化のRMS上限、m。
MAX_DEFORMATION_RMS=0.008

# 必須: smolvlaは実モデル、mechanicsはAIを使わない機械動作の診断。
POLICY_MODE=smolvla
