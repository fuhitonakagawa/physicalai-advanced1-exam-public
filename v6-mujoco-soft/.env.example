# 必須: mps / cpu。指定した装置が使えない場合は停止。
DEVICE=mps
# 必須: native はMuJoCo描画、ray はCPU光線追跡による診断用描画。
RENDERER=native
# 必須: 公開SmolVLAの識別子と固定リビジョン。
MODEL_ID=HuggingFaceVLA/smolvla_libero
MODEL_REVISION=6721902bc4d61e50a3bfdb11dfb4cb626f05d102
# 必須: ダウンロード済みの公開モデルの格納先。
HF_HOME=../.cache/huggingface
# 必須: 実行結果の出力ルート。
OUTPUT_DIR=output
# 必須: INFO / DEBUG / WARNING / ERROR。
LOG_LEVEL=INFO
# 必須: 初期配置と推論の乱数シード。
SEED=42
# 必須: 接触閉鎖の最大制御ステップ数。
GRASP_MAX_STEPS=120
# 必須: 観測更新までに実行する動作数。
ACTION_STEPS=10
# 必須: 動作生成の拡散ステップ数。
DENOISING_STEPS=10
# 必須: 対象と把持指示を並べたJSONファイル。
TASK_FILE=input/tasks.json
# 必須: H.264出力が可能なffmpegの実行ファイル。
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# 必須: 指先と具材の最下面との間隔、メートル。
APPROACH_CLEARANCE=0.0026
# 必須: ルールによる各移動の時間（秒）。
RULE_MOVE_SECONDS=3.0


# 必須: 弾性体のヤング率、Pa。実食品の測定値ではない。
YOUNG_MODULUS_PA=12000
# 必須: 弾性体のポアソン比。
POISSON_RATIO=0.3
# 必須: 弾性の減衰時間係数、秒。
ELASTIC_DAMPING=0.002
# 必須: 具材一個の質量、kg。
SOFT_MASS_KG=0.035
# 必須: SmolVLAの閉鎖提案を待つ制御ステップ数。
MODEL_PROPOSAL_STEPS=10
# 必須: 接触補助制御の一周期あたりの閉鎖量、m。
CLOSE_STEP=0.0005
# 必須: 両指の把持負荷の目標、N。
GRIP_LOAD_TARGET=0.6
# 必須: 過大な把持負荷による閉鎖停止の目安、N。
GRIP_LOAD_LIMIT=2.0
# 必須: 観測した半幅に対する目標開き幅の最大圧縮率。
MAX_COMPRESSION=0.25
# 必須: 具材ごとの把持試行の上限。
MAX_ATTEMPTS=3
# 必須: 開放後の静止確認の最大ステップ数。
SETTLE_STEPS=60
# 必須: 剛体移動を除いた形状変化のRMS上限、m。
MAX_DEFORMATION_RMS=0.008

# 必須: smolvlaは実モデル、mechanicsはAIを使わない機械動作の診断。
POLICY_MODE=smolvla
