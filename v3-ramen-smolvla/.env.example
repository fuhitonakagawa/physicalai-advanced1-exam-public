# 必須: mps / cpu。指定した装置が使えない場合は停止。
DEVICE=mps
# 必須: native はMuJoCo描画、ray はCPU光線追跡による診断用描画。
RENDERER=native
# 必須: 公開SmolVLAの識別子と固定リビジョン。
MODEL_ID=HuggingFaceVLA/smolvla_libero
MODEL_REVISION=6721902bc4d61e50a3bfdb11dfb4cb626f05d102
# 必須: 公開モデルのキャッシュ先。初回実行時に取得し、両バージョンで共有。
HF_HOME=../.cache/huggingface
# 必須: 実行結果の出力ルート。
OUTPUT_DIR=output
# 必須: INFO / DEBUG / WARNING / ERROR。
LOG_LEVEL=INFO
# 必須: 初期配置と推論の乱数シード。
SEED=42
# 必須: 制御ステップ数の上限。20ステップでシミュレーション1秒。
MAX_STEPS=400
# 必須: 観測更新までに実行する動作数。
ACTION_STEPS=10
# 必須: 動作生成の拡散ステップ数。
DENOISING_STEPS=10
# 必須: UTF-8の自然言語指示ファイル。
INSTRUCTION_FILE=input/instruction.txt
# 必須: H.264出力が可能なffmpegの実行ファイル。
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
