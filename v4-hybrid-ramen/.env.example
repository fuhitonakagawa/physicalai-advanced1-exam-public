# 必須: mps / cpu。指定した装置が使えない場合は停止。
DEVICE=mps
# 必須: native はMuJoCo描画、ray はCPU光線追跡による診断用描画。
RENDERER=native
# 必須: 公開SmolVLAの識別子と固定リビジョン。
MODEL_ID=HuggingFaceVLA/smolvla_libero
MODEL_REVISION=6721902bc4d61e50a3bfdb11dfb4cb626f05d102
# 必須: 公開モデルのキャッシュ先。初回実行時に取得し、両バージョンで共有。
HF_HOME=../.cache/huggingface
# 必須: 実行結果の出力ルート。
OUTPUT_DIR=output
# 必須: INFO / DEBUG / WARNING / ERROR。
LOG_LEVEL=INFO
# 必須: 初期配置と推論の乱数シード。
SEED=42
# 必須: 具材ごとの推論把持の制御ステップ上限。
GRASP_MAX_STEPS=120
# 必須: 観測更新までに実行する動作数。
ACTION_STEPS=10
# 必須: 動作生成の拡散ステップ数。
DENOISING_STEPS=10
# 必須: 対象と把持指示を並べたJSONファイル。
TASK_FILE=input/tasks.json
# 必須: H.264出力が可能なffmpegの実行ファイル。
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# 必須: 具材中心から接近目標までの高さ（メートル）。
APPROACH_CLEARANCE=0.005
# 必須: ルールによる各移動の時間（秒）。
RULE_MOVE_SECONDS=2.0

# 必須: pose は接近と開閉、gripper は位置姿勢を保持して開閉のみを推論。
GRASP_CONTROL=gripper
